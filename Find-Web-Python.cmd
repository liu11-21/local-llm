@echo off
rem Fixed inline PowerShell only: no execution-policy override, downloads or install.
rem stdout contains only the verified absolute interpreter path; diagnostics use stderr.
powershell.exe -NoProfile -NonInteractive -Command ^
 "$ErrorActionPreference='Stop'; [Console]::OutputEncoding=[Text.UTF8Encoding]::new();" ^
 "function Probe-Python($exe,$prefix) { $p=New-Object Diagnostics.Process; $p.StartInfo.FileName=$exe; $code='import sys,json,struct;print(json.dumps([sys.executable,list(sys.version_info[:3]),struct.calcsize(chr(80))*8]))'; $p.StartInfo.Arguments=($prefix+' -I -S -B -c '+[char]34+$code+[char]34); $p.StartInfo.UseShellExecute=$false; $p.StartInfo.EnvironmentVariables['PYTHON_MANAGER_AUTOMATIC_INSTALL']='false'; [void]$p.StartInfo.EnvironmentVariables.Remove('PYLAUNCHER_ALLOW_INSTALL'); $p.StartInfo.CreateNoWindow=$true; $p.StartInfo.RedirectStandardOutput=$true; $p.StartInfo.RedirectStandardError=$true; try { [void]$p.Start(); $out=$p.StandardOutput.ReadToEndAsync(); $err=$p.StandardError.ReadToEndAsync(); if(-not $p.WaitForExit(8000)) { $p.Kill(); $p.WaitForExit(); throw 'probe timeout' }; if($p.ExitCode -ne 0) { throw ('probe exit '+$p.ExitCode) }; return ($out.Result.Trim() | ConvertFrom-Json) } finally { $p.Dispose() } };" ^
 "function Compatible-Python($v) { return ($v.Count -eq 3 -and $v[1].Count -eq 3 -and $v[1][0] -eq 3 -and $v[1][1] -eq 12 -and $v[1][2] -ge 10 -and $v[2] -eq 64 -and [IO.Path]::IsPathRooted([string]$v[0]) -and [IO.File]::Exists([string]$v[0])) };" ^
 "function Get-PythonCandidates { foreach($p in @(Get-Command py.exe -All -CommandType Application -ErrorAction SilentlyContinue)) { [pscustomobject]@{exe=$p.Source;prefix='-3.12';source='launcher'} }; foreach($dir in ($env:PATH -split ';')) { $dir=[Environment]::ExpandEnvironmentVariables($dir.Trim().Trim([char]34)); if(-not [IO.Path]::IsPathRooted($dir)) { continue }; foreach($name in @('python.exe','python3.exe','python3.12.exe')) { $p=Join-Path $dir $name; if([IO.File]::Exists($p)) { [pscustomobject]@{exe=$p;prefix='';source='PATH'} } } };" ^
 "foreach($hive in @([Microsoft.Win32.RegistryHive]::CurrentUser,[Microsoft.Win32.RegistryHive]::LocalMachine)) { foreach($view in @([Microsoft.Win32.RegistryView]::Registry64,[Microsoft.Win32.RegistryView]::Registry32)) { $base=$null; try { $base=[Microsoft.Win32.RegistryKey]::OpenBaseKey($hive,$view); $python=$base.OpenSubKey('Software\Python'); if($python) { try { foreach($company in $python.GetSubKeyNames()) { $owner=$python.OpenSubKey($company); try { foreach($tag in $owner.GetSubKeyNames()) { $key=$owner.OpenSubKey($tag+'\InstallPath'); if($key) { try { $p=$key.GetValue('ExecutablePath'); if(-not $p) { $dir=$key.GetValue(''); if($dir) { $p=Join-Path $dir 'python.exe' } }; if($p) { [pscustomobject]@{exe=[Environment]::ExpandEnvironmentVariables($p);prefix='';source=('registry '+$hive+' '+$view)} } } finally { $key.Dispose() } } } } finally { $owner.Dispose() } } } finally { $python.Dispose() } } } catch { [Console]::Error.WriteLine('Python registry read skipped: '+ $_.Exception.Message) } finally { if($base) { $base.Dispose() } } } };" ^
 "foreach($base in @((Join-Path $env:LOCALAPPDATA 'Programs\Python'),$env:ProgramFiles,${env:ProgramFiles(x86)},($env:SystemDrive+'\'))) { if($base -and [IO.Directory]::Exists($base)) { foreach($dir in @(Get-ChildItem -LiteralPath $base -Directory -Filter 'Python*' -ErrorAction SilentlyContinue)) { [pscustomobject]@{exe=(Join-Path $dir.FullName 'python.exe');prefix='';source='installed directory'} } } } };" ^
 "function Select-WebPython { $seen=@{}; foreach($c in Get-PythonCandidates) { $key=$c.exe.ToLowerInvariant()+'|'+$c.prefix; if($seen.ContainsKey($key)) { continue }; $seen[$key]=$true; try { if(-not [IO.File]::Exists($c.exe)) { continue }; if((Get-Item -LiteralPath $c.exe).Length -eq 0) { throw 'empty execution alias, not an interpreter' }; $v=Probe-Python $c.exe $c.prefix; if(-not (Compatible-Python $v)) { throw 'requires Python 3.12.10+ x64' }; $absolute=[IO.Path]::GetFullPath([string]$v[0]); $check=Probe-Python $absolute ''; if(-not (Compatible-Python $check) -or [IO.Path]::GetFullPath([string]$check[0]) -ne $absolute) { throw 'absolute interpreter verification failed' }; [Console]::Error.WriteLine(('Python selected: '+$absolute+' (3.12 x64; '+$c.source+')')); return $absolute } catch { [Console]::Error.WriteLine(('Python rejected ['+$c.source+']: '+$c.exe+' : '+$_.Exception.Message)) } }; throw 'No compatible Python. Install official Python 3.12 x64 (3.12.10+) from https://www.python.org/downloads/windows/ . Keep Windows security enabled.' };" ^
 "try { Write-Output (Select-WebPython) } catch { [Console]::Error.WriteLine($_.Exception.Message); exit 1 }"
exit /b %errorlevel%
