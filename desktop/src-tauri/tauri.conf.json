{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local LLM Workspace",
  "version": "0.8.0",
  "identifier": "com.local-llm.workspace",
  "build": {
    "beforeDevCommand": "npm run ui",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local LLM · AI 工作台",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src asset: http://asset.localhost; style-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/LocalLLM/outputs/*.png",
          "$LOCALDATA/LocalLLM/outputs/*.webm",
          "$LOCALDATA/LocalLLM/outputs/*.flac"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/desktop-worker/LocalLLMWorker/": "worker/",
      "../../build/release-notices/": "notices/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
